ADMIN_EMAIL=admin@example.com
PUBLIC_URL=https://imapsync.example.com
CADDY_URL=imapsync.example.com
PORTSYNC=8081
TZ=Europe/Paris
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=imapsync@example.com
SMTP_USER=imapsync@example.com
SMTP_PASS=replace-me

# Modèles du prétraitement IA (clés enregistrées dans Administration)
MISTRAL_MODEL=mistral-small-latest
GEMINI_MODEL=gemini-2.5-flash

# IP interne exacte de Caddy (ou CIDR du réseau de proxies de confiance uniquement).
# Ne pas utiliser * si le port de l’application est accessible directement.
FORWARDED_ALLOW_IPS=127.0.0.1
